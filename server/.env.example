# MongoDB: use an Atlas cluster or a local replica set (transactions need a replica set)
MONGODB_URI=mongodb://127.0.0.1:27017/festos_demo?replicaSet=rs0
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Auth: "dev" = built-in JWT login with seeded test accounts; "clerk" = Clerk session tokens
AUTH_MODE=dev
JWT_SECRET=change-me-before-demo
SEED_PASSWORD=FestOS@2026

# Clerk (only when AUTH_MODE=clerk). Put the role in each user's publicMetadata: { "role": "festival_director" }
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# Optional: Claude rewrites reason codes into one sentence. Leave blank to use templates only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Path to the CSV pack (relative to /server)
DATA_DIR=../data/raw
